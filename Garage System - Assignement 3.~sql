---Q.20 Calculate the Profit/Loss of the Firm. consider one month salary of each employee for Calculation. ----tbs

SELECT * FROM EMPLOYEES E, SER_DET S,PURCHASE P
WHERE E.EID = S.EID AND S.SPID = P.SPID 

SELECT 
    (
      (SELECT SUM(total_amt) FROM ser_det) - 
      (
        (SELECT SUM(total_cost) FROM purchase) + 
        (SELECT SUM(salary) FROM emp)
      )
    ) AS Net_Profit_Loss
FROM (SELECT * FROM EMPLOYEES E, SER_DET S,PURCHASE P
WHERE E.EID = S.EID AND S.SPID = P.SPID )

