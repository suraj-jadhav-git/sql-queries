---Q.15 Find the annual income of each employee inclusive of Commission --- ---tbs

SELECT 
    E.Ename, (E.Sal * 12) AS Base_Annual_Salary,
    NVL(SUM(S.Comm), 0) AS Total_Commission,
    (E.Sal * 12) + NVL(SUM(S.Comm), 0) AS Total_Annual_Income
FROM 
    Employees E
LEFT JOIN 
    SER_DET S ON E.EID = S.EID
GROUP BY 
    E.Ename, E.Sal;

Commit;
