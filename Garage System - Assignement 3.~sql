       SELECT CID FROM SER_DET);

----Q.3 Employees who have not received the commission.
SELECT EID, ENAME FROM Employees where EID IN (
       SELECT EID FROM SER_DET WHERE COMM > 0);

----Q.4 Name the employee who have maximum Commission.
SELECT EID, ENAME FROM Employees where EID IN (
       SELECT EID FROM SER_DET WHERE COMM = (
              SELECT MAX(COMM) FROM SER_DET));
       
---Q.5 Show employee name and minimum commission amount received by an employee.
SELECT A.EID, A.ENAME,MIN(B.COMM) 
FROM EMPLOYEES A, SER_DET B
WHERE A.EID = B.EID
GROUP BY A.EID, A.ENAME


---Q.6 Display the Middle record from any table.
SELECT * FROM(SELECT C.*, ROWNUM AS RNUM FROM CUSTOMER C)
WHERE RNUM =(select COUNT(*)/2 FROM CUSTOMER)

